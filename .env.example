# Copy this file to .env and fill in your Supabase project's values.
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle;
# never put a service_role/secret key here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL the web build is deployed at, used to build /s/<slug> share
# links shown to the user (e.g. https://vistoria.app). On web itself the
# app can also just read window.location.origin, but native needs this to
# show/copy a full URL. Defaults to http://localhost:8081 if unset.
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:8081
