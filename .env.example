# Supabase project credentials (Settings → API in the Supabase dashboard).
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time by Expo,
# so only put values here that are safe to ship to a client (the anon key is
# meant to be public; access is enforced server-side by Row Level Security).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL where `expo export --platform web` is hosted (see README "Web Viewer").
# Used to build shareable https://.../s/<slug> links that open in any browser
# without installing the app. Falls back to the vistoria:// deep link scheme
# (app-to-app only) when unset.
EXPO_PUBLIC_WEB_BASE_URL=https://vistoria.example.com
